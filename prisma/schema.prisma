generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  FOLLOW_UP
  WON
  LOST
  POSTPONED
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  NOTE
  EDITED
  FOLLOW_UP_SET
}

enum BookingActivityType {
  CREATED
  STATUS_CHANGED
  PAYMENT_ADDED
  PAYMENT_VOIDED
  PRICE_EDITED
  NOTE
}

enum LeadSource {
  INSTAGRAM
  META_AD
  BNI
  PSC
  WEBSITE
  REFERRAL
  B2B_PARTNER
  PHONE
  TR_EVENT
  OTHER
}

enum BookingStatus {
  OPTION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum BookingType {
  PAID
  COLLAB
  B2B
}

enum PaymentKind {
  ADVANCE
  PART
  FINAL
  REFUND
}

enum PaymentMode {
  UPI
  BANK
  CASH
  CHEQUE
}

enum ExpenseCategory {
  OPERATOR_FEE
  TRANSPORT
  FOOD
  VENUE_CUT
  CONSUMABLES
  EQUIPMENT
  SOFTWARE
  CARPENTRY
  EMI
  MARKETING
  ADMIN
  OTHER
}

enum PrintSize {
  TWO_BY_SIX
  FOUR_BY_SIX
}

enum CapitalKind {
  INJECTED
  WITHDRAWN
}

enum BoothUnit {
  UNIT_1
  UNIT_2
}

enum UserRole {
  PARTNER
  SALES
  OPERATOR
}

model Package {
  id        String    @id @default(cuid())
  name      String    @unique
  hours     Int
  price     Int
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model Lead {
  id           String         @id @default(cuid())
  code         String         @unique
  clientName   String
  phone        String
  whatsapp     String?
  city         String?
  eventType    String?
  targetDate   DateTime?
  venue        String?
  source       LeadSource?
  quotedAmount Int?
  packageName  String?
  status       LeadStatus     @default(NEW)
  nextFollowUp DateTime?
  lostReason   String?
  notes        String?
  ownerId      String?
  owner        User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sourceRef    String?        @unique
  booking      Booking?
  activities   LeadActivity[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([city])
  @@index([source])
  @@index([targetDate])
  @@index([nextFollowUp])
  @@index([eventType])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      LeadActivityType
  message   String
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

model Booking {
  id               String            @id @default(cuid())
  code             String            @unique
  leadId           String?           @unique
  lead             Lead?             @relation(fields: [leadId], references: [id])
  packageId        String?
  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  clientName       String
  phone            String
  city             String?
  region           String?           // Region from spreadsheet (e.g., "Patna", "Delhi")
  venue            String?           // Venue & Address from spreadsheet
  mapLink          String?
  eventDate        DateTime          // Event Date from spreadsheet
  startTime        String?           // Timings from spreadsheet (start)
  endTime          String?           // Timings from spreadsheet (end)
  packageName      String
  basePrice        Int               // Package Fee (₹) from spreadsheet
  travelCharge     Int               @default(0)
  discount         Int               @default(0)
  type             BookingType       @default(PAID)
  status           BookingStatus    @default(CONFIRMED)
  payOnEvent       Boolean           @default(false)
  unit             BoothUnit?
  sourceRef        String?           @unique
  printSize        PrintSize?
  printsUsed       Int?
  dayContact       String?
  notes            String?
  advanceReceived  Int               // Advance Recd (₹) from spreadsheet
  balanceDue       Int               // Balance Due (₹) from spreadsheet
  collectionNote   String?           // Collection Note from spreadsheet
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([city])
  @@index([eventDate])
  @@index([eventDate, status])
  @@index([type])
  @@index([packageId])
}

model BookingActivity {
  id        String              @id @default(cuid())
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      BookingActivityType
  message   String
  createdAt DateTime            @default(now())

  @@index([bookingId, createdAt])
}

model Payment {
  id         String      @id @default(cuid())
  bookingId  String
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount     Int
  paidOn     DateTime
  kind       PaymentKind
  mode       PaymentMode
  receivedBy String?
  reference  String?
  sourceRef  String?     @unique
  note       String?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?       @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([bookingId])
  @@index([paidOn])
  @@index([voidedAt])
}

model Expense {
  id          String          @id @default(cuid())
  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category    ExpenseCategory
  amount      Int
  spentOn     DateTime
  paidBy      String?
  note        String?
  receiptPath String?
  sourceRef   String?         @unique
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([bookingId])
  @@index([category])
  @@index([spentOn])
  @@index([voidedAt])
}

model CapitalEntry {
  id          String       @id @default(cuid())
  partnerId   String
  partner     User         @relation("CapitalPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  kind        CapitalKind
  amount      Int
  date        DateTime
  mode        PaymentMode?
  note        String?
  sourceRef   String?      @unique
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?        @relation("CapitalVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([partnerId])
  @@index([voidedAt])
}

model ImportRun {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  fileSha256    String
  countsJson    Json
  warningsCount Int
  decisionsJson Json
  targetHost    String
}

model Counter {
  name      String   @id
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String            @id
  name              String
  email             String
  emailVerified     Boolean           @default(false)
  image             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  role              UserRole          @default(PARTNER)
  disabled          Boolean           @default(false)
  sessions          Session[]
  accounts          Account[]
  ownedLeads        Lead[]            @relation("LeadOwner")
  capitalEntries    CapitalEntry[]    @relation("CapitalPartner")
  voidedCapitalEntries CapitalEntry[] @relation("CapitalVoidedBy")
  leadActivities    LeadActivity[]
  bookingActivities BookingActivity[]
  voidedPayments    Payment[]         @relation("PaymentVoidedBy")
  voidedExpenses    Expense[]         @relation("ExpenseVoidedBy")
  auditLogs         AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
