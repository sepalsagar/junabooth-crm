generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  FOLLOW_UP
  WON
  LOST
  POSTPONED
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  NOTE
  EDITED
  FOLLOW_UP_SET
}

enum BookingActivityType {
  CREATED
  STATUS_CHANGED
  PAYMENT_ADDED
  PAYMENT_VOIDED
  PRICE_EDITED
  NOTE
}

enum LeadSource {
  INSTAGRAM
  META_AD
  BNI
  PSC
  WEBSITE
  REFERRAL
  B2B_PARTNER
  PHONE
  TR_EVENT
  OTHER
}

enum BookingStatus {
  OPTION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum BookingType {
  PAID
  COLLAB
  B2B
}

enum PaymentKind {
  ADVANCE
  PART
  FINAL
  REFUND
}

enum PaymentMode {
  UPI
  BANK
  CASH
  CHEQUE
}

enum ExpenseCategory {
  OPERATOR_FEE
  TRANSPORT
  FOOD
  VENUE_CUT
  CONSUMABLES
  EQUIPMENT
  SOFTWARE
  CARPENTRY
  EMI
  MARKETING
  ADMIN
  OTHER
}

enum PrintSize {
  TWO_BY_SIX
  FOUR_BY_SIX
}

enum CapitalKind {
  INJECTED
  WITHDRAWN
}

enum UserRole {
  PARTNER
  SALES
  OPERATOR
}

model Package {
  id        String    @id @default(cuid())
  name      String    @unique
  hours     Int
  price     Int
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Lead {
  id           String         @id @default(cuid())
  code         String         @unique
  clientName   String
  phone        String
  whatsapp     String?
  city         String?
  eventType    String?
  targetDate   DateTime?
  venue        String?
  source       LeadSource?
  quotedAmount Int?
  packageName  String?
  status       LeadStatus     @default(NEW)
  nextFollowUp DateTime?
  lostReason   String?
  notes        String?
  ownerId      String?
  owner        User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  booking      Booking?
  activities   LeadActivity[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([city])
  @@index([source])
  @@index([targetDate])
  @@index([nextFollowUp])
  @@index([eventType])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      LeadActivityType
  message   String
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

model Booking {
  id           String            @id @default(cuid())
  code         String            @unique
  leadId       String?           @unique
  lead         Lead?             @relation(fields: [leadId], references: [id])
  packageId    String?
  package      Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  clientName   String
  phone        String
  city         String?
  venue        String?
  mapLink      String?
  eventDate    DateTime
  startTime    String?
  endTime      String?
  packageName  String
  basePrice    Int
  travelCharge Int               @default(0)
  discount     Int               @default(0)
  type         BookingType       @default(PAID)
  status       BookingStatus     @default(CONFIRMED)
  payOnEvent   Boolean           @default(false)
  printSize    PrintSize?
  printsUsed   Int?
  dayContact   String?
  notes        String?
  payments     Payment[]
  expenses     Expense[]
  activities   BookingActivity[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([city])
  @@index([eventDate])
  @@index([type])
  @@index([packageId])
}

model BookingActivity {
  id        String              @id @default(cuid())
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      BookingActivityType
  message   String
  createdAt DateTime            @default(now())

  @@index([bookingId, createdAt])
}

model Payment {
  id         String      @id @default(cuid())
  bookingId  String
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount     Int
  paidOn     DateTime
  kind       PaymentKind
  mode       PaymentMode
  receivedBy String?
  reference  String?
  note       String?
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?       @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([bookingId])
  @@index([paidOn])
  @@index([voidedAt])
}

model Expense {
  id          String          @id @default(cuid())
  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category    ExpenseCategory
  amount      Int
  spentOn     DateTime
  paidBy      String?
  note        String?
  receiptPath String?
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([bookingId])
  @@index([category])
  @@index([spentOn])
  @@index([voidedAt])
}

model CapitalEntry {
  id          String       @id @default(cuid())
  partnerId   String
  partner     User         @relation("CapitalPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  kind        CapitalKind
  amount      Int
  date        DateTime
  mode        PaymentMode?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Counter {
  name      String   @id
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String            @id
  name              String
  email             String
  emailVerified     Boolean           @default(false)
  image             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  role              UserRole          @default(PARTNER)
  sessions          Session[]
  accounts          Account[]
  ownedLeads        Lead[]            @relation("LeadOwner")
  capitalEntries    CapitalEntry[]    @relation("CapitalPartner")
  leadActivities    LeadActivity[]
  bookingActivities BookingActivity[]
  voidedPayments    Payment[]         @relation("PaymentVoidedBy")
  voidedExpenses    Expense[]         @relation("ExpenseVoidedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
