
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  FOLLOW_UP
  WON
  LOST
  POSTPONED
}

enum LeadSource {
  INSTAGRAM
  META_AD
  BNI
  PSC
  WEBSITE
  REFERRAL
  B2B_PARTNER
  PHONE
  TR_EVENT
  OTHER
}

enum BookingStatus {
  OPTION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum BookingType {
  PAID
  COLLAB
  B2B
}

enum PaymentKind {
  ADVANCE
  PART
  FINAL
  REFUND
}

enum PaymentMode {
  UPI
  BANK
  CASH
  CHEQUE
}

enum ExpenseCategory {
  OPERATOR_FEE
  TRANSPORT
  FOOD
  VENUE_CUT
  CONSUMABLES
  EQUIPMENT
  SOFTWARE
  MARKETING
  ADMIN
  OTHER
}

enum CapitalKind {
  INJECTED
  WITHDRAWN
}

enum UserRole {
  PARTNER
  SALES
  OPERATOR
}

model Lead {
  id           String      @id @default(cuid())
  code         String      @unique
  clientName   String
  phone        String
  whatsapp     String?
  city         String?
  eventType    String?
  targetDate   DateTime?
  venue        String?
  source       LeadSource?
  quotedAmount Int?
  packageName  String?
  status       LeadStatus  @default(NEW)
  nextFollowUp DateTime?
  lostReason   String?
  notes        String?
  ownerId      String?
  owner        User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  booking      Booking?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([city])
  @@index([source])
  @@index([targetDate])
  @@index([nextFollowUp])
  @@index([eventType])
}

model Booking {
  id           String        @id @default(cuid())
  code         String        @unique
  leadId       String?       @unique
  lead         Lead?         @relation(fields: [leadId], references: [id])
  clientName   String
  phone        String
  city         String?
  venue        String?
  mapLink      String?
  eventDate    DateTime
  startTime    String?
  endTime      String?
  packageName  String
  basePrice    Int
  travelCharge Int           @default(0)
  discount     Int           @default(0)
  type         BookingType   @default(PAID)
  status       BookingStatus @default(CONFIRMED)
  dayContact   String?
  notes        String?
  payments     Payment[]
  expenses     Expense[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([city])
  @@index([eventDate])
  @@index([type])
}

model Payment {
  id         String      @id @default(cuid())
  bookingId  String
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount     Int
  paidOn     DateTime
  kind       PaymentKind
  mode       PaymentMode
  receivedBy String?
  reference  String?
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([bookingId])
  @@index([paidOn])
}

model Expense {
  id         String          @id @default(cuid())
  bookingId  String?
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category   ExpenseCategory
  amount     Int
  spentOn    DateTime
  paidBy     String?
  note       String?
  receiptUrl String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([bookingId])
  @@index([category])
  @@index([spentOn])
}

model CapitalEntry {
  id          String       @id @default(cuid())
  partnerId   String
  partner     User         @relation("CapitalPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  kind        CapitalKind
  amount      Int
  date        DateTime
  mode        PaymentMode?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Counter {
  name      String   @id
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(PARTNER)
  sessions      Session[]
  accounts      Account[]
  ownedLeads    Lead[]    @relation("LeadOwner")
  capitalEntries CapitalEntry[] @relation("CapitalPartner")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
